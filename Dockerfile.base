FROM python:3.11-slim

LABEL org.opencontainers.image.title="PDF document tools base"
LABEL org.opencontainers.image.description="Reusable Python base with LibreOffice, Poppler, Tesseract, Ghostscript, LaTeX equation rendering, Python native-build dependencies and multilingual Office/math-compatible fonts"

# Document-processing runtime plus the native build toolchain required by Python
# packages such as pycairo (pulled by xhtml2pdf/reportlab extras). Keeping these
# in the reusable image prevents every Coolify deployment from rebuilding or
# failing on the same system prerequisites.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-fra \
    tesseract-ocr-deu \
    tesseract-ocr-spa \
    tesseract-ocr-ita \
    ghostscript \
    fontconfig \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-crosextra-carlito \
    fonts-crosextra-caladea \
    fonts-noto-core \
    fonts-lohit-beng-bengali \
    fonts-stix \
    fonts-texgyre \
    fonts-texgyre-math \
    fonts-lmodern \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-fonts-recommended \
    dvipng \
    build-essential \
    pkg-config \
    libcairo2-dev \
    libffi-dev \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
